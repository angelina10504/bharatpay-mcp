FROM apache/airflow:3.3.2-python3.11
COPY --chown=airflow:root src /opt/project/src
COPY --chown=airflow:root pipelines /opt/project/pipelines
COPY --chown=airflow:root tests/fixtures /opt/project/tests/fixtures
COPY --chown=airflow:root scripts/check_dag.py /opt/project/scripts/check_dag.py
RUN pip install --no-cache-dir "pymongo>=4.13,<5" "httpx>=0.27,<1"
